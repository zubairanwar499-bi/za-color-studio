# Copy this file to .env and fill in whichever free keys you have.
# ZA Color Studio tries providers TOP TO BOTTOM, and rotates through
# every key you list for a provider (comma-separated, no spaces) before
# moving to the next provider. You do not need all of them - even zero
# keys still works, because the last provider is a built-in local
# generator that never fails.

PORT=3000

# 1) Groq — https://console.groq.com/keys  (free tier, very fast, generous limits)
GROQ_API_KEYS=

# 2) OpenRouter — https://openrouter.ai/keys  (use a ":free" model, no cost)
OPENROUTER_API_KEYS=

# 3) Google Gemini — https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEYS=

# You can put MULTIPLE keys per provider to survive rate limits, e.g.:
# GROQ_API_KEYS=gsk_aaaa,gsk_bbbb,gsk_cccc
